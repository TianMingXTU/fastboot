# .env (示例)
# 环境变量会覆盖 YAML 文件中的同名顶层配置 (如果 GlobalSettings 中定义了对应字段)
# 对于嵌套配置，环境变量名需要包含前缀和下划线分隔的路径
# 例如 FASTBOOT_APP_PORT 会设置 app.port
#      FASTBOOT_DB_TYPE 会设置 db.type

# --- 应用配置覆盖 ---
# FASTBOOT_APP_NAME="FastBoot App (.env)"
#FASTBOOT_APP_PORT=8081
#FASTBOOT_APP_LOG_LEVEL="DEBUG"
#FASTBOOT_APP_ENV="development" # 覆盖 app.env

# --- 数据库配置覆盖 (示例：切换到并配置MySQL) ---
#FASTBOOT_DB_TYPE="mysql"
#FASTBOOT_DB_NAME="my_production_db"
#FASTBOOT_DB_HOST="db.example.com"
#FASTBOOT_DB_PORT=3306
#FASTBOOT_DB_USERNAME="prod_user"
#FASTBOOT_DB_PASSWORD="a_very_strong_and_secret_password_from_env" # 敏感信息放在这里！
#FASTBOOT_DB_GENERATE_SCHEMAS=false # 生产环境通常不自动生成

# --- 其他配置 ---
# FASTBOOT_REDIS_URL="redis://localhost:6379/0"
# FASTBOOT_SECRET_KEY="another_super_secret_key_for_production_from_env"